{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "files_changed"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "files_changed": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}

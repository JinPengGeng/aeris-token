# deploy/multi-node/docker-compose.standalone.yml 的示例环境。
# 复制为 .env.standalone 并替换所有 REPLACE_* 占位；不要把真实凭据提交到仓库。
APP_IMAGE=ghcr.io/jinpenggeng/aeris-token:REPLACE_WITH_DIGEST

# Postgres（standalone 编排内置实例）
DB_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
POSTGRES_MAX_CONNECTIONS=200

# Redis（standalone 编排内置实例，AOF everysec）
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD

# 三节点共享的密钥；至少 32 字节随机值，节点间必须一致。
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32_BYTE_JWT_SECRET
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_ENCRYPTION_KEY

# 只包含本编排内 nginx/LB 的网段（compose 默认 172.x 网段按实际 bridge 调整），
# 不要把公网网段加入信任列表。
AETHER_GATEWAY_TRUSTED_INGRESS_CIDRS=172.0.0.0/8

# 跨节点 tunnel owner 转发需要可从其他节点访问的 relay 地址；
# standalone 单机演练可留空。
AETHER_TUNNEL_RELAY_BASE_URL=

# 独立演练默认打开一致性优先（多节点 fail-open ×N 防护）；
# 对外生产按 docs/adr/redis-consistency-first.md 决策。
AETHER_CONSISTENCY_FIRST=true

# LB 暴露端口（宿主机）。
LB_PORT=8080
